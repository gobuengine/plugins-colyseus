[submodule "third_party/sds"]
	path = Source/third_party/sds
	url = https://github.com/antirez/sds.git
[submodule "third_party/uthash"]
	path = Source/third_party/uthash
	url = https://github.com/troydhanson/uthash.git
[submodule "third_party/cJSON"]
	path = Source/third_party/cJSON
	url = https://github.com/DaveGamble/cJSON.git
[submodule "third_party/wslay"]
	path = Source/third_party/wslay
	url = https://github.com/tatsuhiro-t/wslay.git
[submodule "third_party/mbedtls"]
	path = Source/third_party/mbedtls
    url = https://github.com/Mbed-TLS/mbedtls.git
    shallow = true
