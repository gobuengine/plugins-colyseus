module Colyseus
## Colyseus SDK for Gobu (0.18.15): the client of the plugin's native classes (_ColyseusClient,
## _ColyseusRoom, _ColyseusCallbacks), on Windows and the web (Gobu's web templates without threads).
##
## Every wrapper is a `struct` with an `impl` block. Structs are values: keep them in `mut` variables and
## call methods on those variables (a struct returned by a call and used inline is a temporary copy).
##
## Usage:
##   mut client := Colyseus.Client.new("ws://localhost:2567")
##   mut room := client.join_or_create("my_room")
##   room.on_state_changed(fn() { print(room.get_state()) })
##   mut callbacks := room.callbacks()
##   callbacks.listen("score", fn(value: float, previous: float) { print(value) })
##
## - Signals live on the native room: `room.native.joined.connect(cb)`, or use the `room.on_joined(cb)`
##   helpers.
## - Read-only properties are methods: `room.is_connected()`, `room.get_session_id()`.
## - The state is Dictionaries (`room.get_state()`), described by the server's reflection; a game may describe
##   it itself with `Colyseus.field()` and `Colyseus.schema()` (`room.set_state_type()`).

# =============================================================================
# Schema type constants
# =============================================================================

## String type
STRING :: "string"
## Number type (64-bit float)
NUMBER :: "number"
## Boolean type
BOOLEAN :: "boolean"
## Signed 8-bit integer
INT8 :: "int8"
## Unsigned 8-bit integer
UINT8 :: "uint8"
## Signed 16-bit integer
INT16 :: "int16"
## Unsigned 16-bit integer
UINT16 :: "uint16"
## Signed 32-bit integer
INT32 :: "int32"
## Unsigned 32-bit integer
UINT32 :: "uint32"
## Signed 64-bit integer
INT64 :: "int64"
## Unsigned 64-bit integer
UINT64 :: "uint64"
## 32-bit float
FLOAT32 :: "float32"
## 64-bit float
FLOAT64 :: "float64"
## Map collection type (key-value pairs)
MAP :: "map"
## Array collection type (ordered list)
ARRAY :: "array"
## Reference to another schema
REF :: "ref"

## How a `room.request()` failed: the `code` of its `err`.
## The room's handler rejected it (`err["reason"]` is what it gave).
REQUEST_REJECTED :: 1
## The room's handler failed, or the room has none for that type.
REQUEST_FAULTED :: 2
## The connection closed before the reply.
REQUEST_CLOSED :: 3
## No reply in time.
REQUEST_TIMED_OUT :: 4

## Auth operations (the op of the native auth_request()); the order is the ABI.
_AUTH_GET_USER_DATA :: 0
_AUTH_REGISTER :: 1
_AUTH_SIGN_IN :: 2
_AUTH_SIGN_IN_ANONYMOUS :: 3
_AUTH_SEND_PASSWORD_RESET :: 4

# =============================================================================
# Polling
# =============================================================================

## Runs the network and hands out its events. The plugin does it every frame by itself: call it only to see an
## answer sooner, in the middle of a frame.
static fn poll() void {
	_ColyseusClient.poll()
}

## @deprecated: Use Colyseus.Client.new("ws://localhost:2567") instead.
static fn create_client() Client {
	push_warning("Colyseus.create_client() is deprecated. Use Colyseus.Client.new(endpoint) instead.")
	return Client.new("")
}

## @deprecated: Use room.callbacks() instead.
static fn callbacks(native_room: _ColyseusRoom) Callbacks {
	push_warning("Colyseus.callbacks(room) is deprecated. Use room.callbacks() instead.")
	return Callbacks.of(native_room)
}

# =============================================================================
# Schema definition helpers
# =============================================================================
##
## Describe your state with plain data, e.g.:
##
##   mut player := Colyseus.schema([
##       Colyseus.field("x", Colyseus.NUMBER),
##       Colyseus.field("y", Colyseus.NUMBER),
##   ])
##   mut room_state := Colyseus.schema([
##       Colyseus.field_of("players", Colyseus.MAP, player),
##       Colyseus.field_of_type("scores", Colyseus.ARRAY, Colyseus.NUMBER),
##   ])
##   room.set_state_type(room_state)

## A field of a primitive type: { name, type, key_type }.
static fn field(field_name: String, field_type: String, key: String = "string") Dictionary {
	return { "name": field_name, "type": field_type, "key_type": key }
}

## A collection (MAP, ARRAY) or a REF whose elements are another schema (Colyseus.schema()).
static fn field_of(field_name: String, field_type: String, child: Dictionary, key: String = "string") Dictionary {
	return { "name": field_name, "type": field_type, "child_type": child, "key_type": key }
}

## A collection (MAP, ARRAY) of a primitive type (Colyseus.NUMBER...).
static fn field_of_type(field_name: String, field_type: String, child_type: String, key: String = "string") Dictionary {
	return { "name": field_name, "type": field_type, "child_type": child_type, "key_type": key }
}

## A schema definition: { "fields": [field, ...] }.
static fn schema(fields: []Dictionary) Dictionary {
	return { "fields": fields }
}

## Check if a field definition holds a primitive type
static fn field_is_primitive(field_def: Dictionary) bool {
	return is_primitive_type(str(field_def.get("type", "")))
}

## Check if a field definition is a collection (MAP or ARRAY)
static fn field_is_collection(field_def: Dictionary) bool {
	return is_collection_type(str(field_def.get("type", "")))
}

## Check if a field definition is a reference to another schema
static fn field_is_ref(field_def: Dictionary) bool {
	return str(field_def.get("type", "")) == REF
}

## Check if a type string represents a primitive type
static fn is_primitive_type(type_str: String) bool {
	return type_str in [STRING, NUMBER, BOOLEAN, INT8, UINT8, INT16, UINT16, INT32, UINT32, INT64, UINT64, FLOAT32, FLOAT64]
}

## Check if a type string represents a collection type
static fn is_collection_type(type_str: String) bool {
	return type_str in [MAP, ARRAY]
}

# =============================================================================
# Reply routing (HTTP, Auth, latency and room requests)
# =============================================================================
##
## Callback-based requests answer through native signals: a client's `_http_response` / `_http_error` (HTTP,
## Auth and latency share its request ids), a room's `_request_reply`. The table (request_id -> Callable) lives
## here, one per native object (by its instance id): a Dictionary is a value in Grost, so the Client, HTTP and
## Auth structs each holding one would each have their own copy.
static mut _replies : Dictionary[int, Dictionary] = {}

## Remembers `callback` for `request_id` of `owner` (a native client or room), and hands the id straight back so
## a dispatch reads as one line.
static fn _replies_track(owner: Object, request_id: int, callback: Callable) int {
	if owner != null and request_id != 0 and callback.is_valid() {
		key := owner.get_instance_id()
		if not _replies.has(key) {
			_replies[key] = {}
		}
		_replies[key][request_id] = callback
	}
	return request_id
}

## `owner_id`: the native client's or room's instance id (the answers' handlers hold the id, not the object:
## holding it from its own signals, the object would never be freed).
static fn _replies_take(owner_id: int, request_id: int) Callable {
	key := owner_id
	if not _replies.has(key) or not _replies[key].has(request_id) {
		return Callable()
	}
	callback : Callable = (_replies[key][request_id] as Callable) ?? Callable()
	_ = _replies[key].erase(request_id)
	if _replies[key].is_empty() {
		_ = _replies.erase(key)
	}
	return callback
}

## Every request answers `callback(err: Dictionary, data: Dictionary)`: `err` is empty when it went well,
## else `{ "code": int, "message": String }`; `data` is the reply's JSON object (other JSON in
## `data["value"]`, a reply that isn't JSON in `data["text"]`).
static fn _on_http_response(client_id: int, request_id: int, _status_code: int, body: String) void {
	callback := _replies_take(client_id, request_id)
	if not callback.is_valid() {
		return
	}
	mut json := JSON.new()
	mut data : Dictionary = { "text": body }
	if json.parse(body) == OK {
		data = (json.data as Dictionary) ?? { "value": json.data }
	}
	callback.call({}, data)
}

static fn _on_http_error(client_id: int, request_id: int, code: int, message: String) void {
	callback := _replies_take(client_id, request_id)
	if callback.is_valid() {
		callback.call({ "code": code, "message": message }, {})
	}
}

## A room request's reply (`outcome` 0, or a REQUEST_* code): `data` is the reply, or the reason of a rejection or
## a failure.
static fn _on_request_reply(room_id: int, request_id: int, outcome: int, data: Dictionary, reason: String) void {
	callback := _replies_take(room_id, request_id)
	if not callback.is_valid() {
		return
	}
	if outcome == 0 {
		callback.call({}, data)
		return
	}
	mut message := reason
	if outcome == REQUEST_REJECTED {
		message = str(data["value"]) if data.has("value") else JSON.stringify(data)
	} elif outcome == REQUEST_FAULTED {
		message = str(data.get("message", "The room's handler failed."))
	}
	callback.call({ "code": outcome, "message": message, "reason": data }, {})
}


# =============================================================================
# Callbacks
# =============================================================================

## Wraps the native ColyseusCallbacks: callbacks on the room's state. Each one returns a handle for
## `remove()`, or -1. A `target` is a nested schema of the state (a Dictionary of `room.get_state()`);
## without one, the root state.
Callbacks :: struct {
	native : _ColyseusCallbacks = null
}

impl Callbacks {
	## Build the callbacks helper for a native room (prefer `room.callbacks()`).
	fn of(native_room: _ColyseusRoom) Callbacks {
		mut result := Callbacks{}
		if native_room != null {
			result.native = _ColyseusCallbacks.get(native_room) as _ColyseusCallbacks
		}
		if result.native == null {
			push_error("Colyseus: ColyseusCallbacks not available. Make sure the Colyseus plugin is enabled (Project Settings > Plugins) and the room has joined.")
		}
		return result
	}

	fn is_valid(self) bool {
		return self.native != null
	}

	## `callback(value, previous_value)` when `property` changes.
	fn listen(self, property: String, callback: Callable, target: Dictionary = {}) int {
		if target.is_empty() {
			return self.native.listen(property, callback)
		}
		return self.native.listen(target, property, callback)
	}

	## `callback(item, key)` when an item is added to the collection `property`.
	fn on_add(self, property: String, callback: Callable, target: Dictionary = {}) int {
		if target.is_empty() {
			return self.native.on_add(property, callback)
		}
		return self.native.on_add(target, property, callback)
	}

	## `callback(item, key)` when an item is removed from the collection `property`.
	fn on_remove(self, property: String, callback: Callable, target: Dictionary = {}) int {
		if target.is_empty() {
			return self.native.on_remove(property, callback)
		}
		return self.native.on_remove(target, property, callback)
	}

	## `callback()` when the state (or `target`) changes; with a `property`, when that collection changes.
	fn on_change(self, callback: Callable, property: String = "", target: Dictionary = {}) int {
		if target.is_empty() {
			if property == "" {
				return self.native.on_change(callback)
			}
			return self.native.on_change(property, callback)
		}
		if property == "" {
			return self.native.on_change(target, callback)
		}
		return self.native.on_change(target, property, callback)
	}

	fn remove(self, handle: int) void {
		self.native.remove(handle)
	}
}

# =============================================================================
# Room
# =============================================================================

## Wraps the native ColyseusRoom. Signals are exposed on `room.native`
## (`joined`, `state_changed`, `message_received(type, data)`,
## `error(code, message)`, `left(code, reason)`, `dropped(code, reason)`,
## `reconnected`, `pong(rtt_ms)`), or through the `on_*` helpers below.
Room :: struct {
	native : _ColyseusRoom = null
}

impl Room {
	fn new(native_room: _ColyseusRoom) Room {
		if native_room != null {
			# The replies of request() go by the room's id (see _replies_take()).
			room_id : int = native_room.get_instance_id()
			mut on_reply := fn(request_id: int, outcome: int, data: Dictionary, reason: String) { _on_request_reply(room_id, request_id, outcome, data, reason) }
			native_room._request_reply.connect(on_reply)
		}
		return Room{ .native = native_room }
	}

	fn is_valid(self) bool {
		return self.native != null
	}

	# --- signal helpers ------------------------------------------------------

	fn on_joined(self, callback: Callable) void {
		self.native.joined.connect(callback)
	}

	fn on_state_changed(self, callback: Callable) void {
		self.native.state_changed.connect(callback)
	}

	## `callback(type: String, data: Dictionary)` (the types the server sends: `type` is an int for a message
	## sent with a number, `data` a number for one that carries a number).
	fn on_message(self, callback: Callable) void {
		self.native.message_received.connect(callback)
	}

	## `callback(code: int, message: String)`
	fn on_error(self, callback: Callable) void {
		self.native.error.connect(callback)
	}

	## `callback(code: int, reason: String)`
	fn on_left(self, callback: Callable) void {
		self.native.left.connect(callback)
	}

	## `callback(code: int, reason: String)`
	fn on_dropped(self, callback: Callable) void {
		self.native.dropped.connect(callback)
	}

	fn on_reconnected(self, callback: Callable) void {
		self.native.reconnected.connect(callback)
	}

	# --- messaging -----------------------------------------------------------

	## Send a message of `type` to the server, with `data` (none when empty).
	fn send_message(self, type: String, data: Dictionary = {}) void {
		if data.is_empty() {
			self.native.send_message(type, null)
		} else {
			self.native.send_message(type, data)
		}
	}

	## Send a message whose type is a number, with `data` (none when empty).
	fn send_message_int(self, type: int, data: Dictionary = {}) void {
		if data.is_empty() {
			self.native.send_message_int(type, null)
		} else {
			self.native.send_message_int(type, data)
		}
	}

	## Send a message and wait for the server's reply, the value its `onMessage(type)` handler returns:
	## `callback(err: Dictionary, data: Dictionary)`, as an HTTP request answers (a reply that isn't an object in
	## `data["value"]`). `err` is empty when it went well, else `{ "code": int, "message": String, "reason":
	## Dictionary }` with a REQUEST_* code. Without a reply in `timeout_ms` (0: no limit) it fails with
	## REQUEST_TIMED_OUT. Returns the request's id, 0 when it could not be sent.
	fn request(self, type: String, data: Dictionary, callback: Callable, timeout_ms: int = 10000) int {
		if self.native == null {
			return 0
		}
		mut request_id : int = 0
		# The plugin answers it as REQUEST_TIMED_OUT when timeout_ms passes without a reply.
		if data.is_empty() {
			request_id = self.native.request(type, null, timeout_ms)
		} else {
			request_id = self.native.request(type, data, timeout_ms)
		}
		return _replies_track(self.native, request_id, callback)
	}

	## Measure the round trip to the room over its connection: `callback(rtt_ms: int)`. Returns false (and
	## `callback` never runs) when the room isn't connected. A new ping replaces one still waiting.
	fn ping(self, callback: Callable) bool {
		if self.native == null or not self.native.ping() {
			return false
		}
		self.native.pong.connect(callback, CONNECT_ONE_SHOT)
		return true
	}

	fn leave(self) void {
		self.native.leave()
	}

	fn get_id(self) String {
		return self.native.get_id()
	}

	fn get_session_id(self) String {
		return self.native.get_session_id()
	}

	## Token for [method Client.reconnect]. Persist it to re-take this seat
	## after the process is killed (the server must `allowReconnection()`).
	fn get_reconnection_token(self) String {
		return self.native.get_reconnection_token()
	}

	fn get_name(self) String {
		return self.native.get_name()
	}

	fn is_connected(self) bool {
		# (Object has its own is_connected(signal, callable).)
		return (self.native.call(&"is_connected") as bool) ?? false
	}

	fn is_reconnecting(self) bool {
		return self.native.is_reconnecting()
	}

	## Tune automatic reconnection. Pass any subset of the following keys:
	##   enabled: bool, max_retries: int, min_delay_ms: int, max_delay_ms: int,
	##   min_uptime_ms: int, delay_ms: int, max_enqueued_messages: int.
	## Omitted keys keep their current value. Defaults match the @colyseus/sdk
	## TypeScript SDK.
	fn set_reconnection_options(self, options: Dictionary) void {
		self.native.set_reconnection_options(options)
	}

	fn get_state(self) Dictionary {
		return self.native.get_state()
	}

	## The state's description: a schema of `Colyseus.schema()`.
	fn set_state_type(self, state_type: Dictionary) void {
		self.native.set_state_type(state_type)
	}

	## The state's description by the name the server registered it with.
	fn set_state_type_name(self, state_type: String) void {
		self.native.set_state_type(state_type)
	}

	# --- helpers over the native room ----------------------------------------

	## Callbacks helper bound to this room.
	fn callbacks(self) Callbacks {
		return Callbacks.of(self.native)
	}
}

# =============================================================================
# HTTP — callback-based HTTP requests
# =============================================================================

## HTTP client for making requests to the Colyseus server. Each request answers
## `callback(err: Dictionary, data: Dictionary)` (see `_on_http_response`); the body goes as JSON.
## Note: "get" is renamed to "get_request" because Object.get() is reserved.
## Usage:
##   client.http.get_request("/test", fn(err: Dictionary, data: Dictionary) { print(data) })
##   client.http.post("/save", {"key": "val"}, fn(err: Dictionary, data: Dictionary) { print(err.is_empty()) })
HTTP :: struct {
	native : _ColyseusClient = null
}

impl HTTP {
	## Set the auth token (sent as Bearer header on all requests)
	fn set_auth_token(self, value: String) void {
		if self.native != null {
			self.native.auth_set_token(value)
		}
	}

	fn get_auth_token(self) String {
		if self.native == null {
			return ""
		}
		return self.native.auth_get_token()
	}

	## GET request (named get_request to avoid conflict with Object.get)
	fn get_request(self, path: String, callback: Callable) int {
		return _replies_track(self.native, self.native.http_get(path), callback)
	}

	## POST request
	fn post(self, path: String, body: Dictionary, callback: Callable) int {
		return _replies_track(self.native, self.native.http_post(path, JSON.stringify(body)), callback)
	}

	## PUT request
	fn put(self, path: String, body: Dictionary, callback: Callable) int {
		return _replies_track(self.native, self.native.http_put(path, JSON.stringify(body)), callback)
	}

	## DELETE request
	fn delete(self, path: String, callback: Callable) int {
		return _replies_track(self.native, self.native.http_delete(path), callback)
	}

	## PATCH request
	fn patch(self, path: String, body: Dictionary, callback: Callable) int {
		return _replies_track(self.native, self.native.http_patch(path, JSON.stringify(body)), callback)
	}
}

# =============================================================================
# Auth — token management
# =============================================================================

## Auth module for managing authentication tokens.
## Usage:
##   client.auth.set_token("my-jwt-token")
##   mut token := client.auth.get_token()
Auth :: struct {
	native : _ColyseusClient = null
}

impl Auth {
	## Set the auth token (sent as Bearer header on every later request)
	fn set_token(self, token: String) void {
		self.native.auth_set_token(token)
	}

	## Get the current auth token, or "" when signed out
	fn get_token(self) String {
		return self.native.auth_get_token()
	}

	## Sign in without credentials. The token still identifies the player, so
	## keep it if you want them back on the same account next launch.
	fn sign_in_anonymously(self, callback: Callable, options: Dictionary = {}) int {
		return self.request(_AUTH_SIGN_IN_ANONYMOUS, "", "", callback, options)
	}

	## Create an account. `options` is merged into the request body.
	fn register_with_email_and_password(self, email: String, password: String, callback: Callable, options: Dictionary = {}) int {
		return self.request(_AUTH_REGISTER, email, password, callback, options)
	}

	fn sign_in_with_email_and_password(self, email: String, password: String, callback: Callable) int {
		return self.request(_AUTH_SIGN_IN, email, password, callback)
	}

	## The user record behind the current token. Fails when there is none.
	fn get_user_data(self, callback: Callable) int {
		return self.request(_AUTH_GET_USER_DATA, "", "", callback)
	}

	fn send_password_reset_email(self, email: String, callback: Callable) int {
		return self.request(_AUTH_SEND_PASSWORD_RESET, email, "", callback)
	}

	## Drop the token locally and clear it from secure storage. No request.
	fn sign_out(self) void {
		self.native.auth_signout()
	}

	## Every call answers the same way an HTTP one does — `callback(err: Dictionary, data: Dictionary)`,
	## where a successful `data` is `{ "user": {...}, "token": "..." }`, the
	## shape the server replied with.
	fn request(self, op: int, email: String, password: String, callback: Callable, options: Dictionary = {}) int {
		mut options_json := ""
		if not options.is_empty() {
			options_json = JSON.stringify(options)
		}
		return _replies_track(self.native, self.native.auth_request(op, email, password, options_json), callback)
	}
}

# =============================================================================
# Client — exposes .http and .auth sub-objects
# =============================================================================

## Wraps the native ColyseusClient to provide .http and .auth accessors
## matching the TypeScript SDK structure.
Client :: struct {
	native : _ColyseusClient = null
	http : HTTP
	auth : Auth
}

impl Client {
	## Create a client. `endpoint` is e.g. "ws://localhost:2567".
	fn new(endpoint: String = "") Client {
		mut client := Client{}
		client.native = _ColyseusClient.new()
		if client.native == null {
			push_error("Colyseus: ColyseusClient not available. Make sure the Colyseus plugin is enabled (Project Settings > Plugins).")
			return client
		}

		# HTTP and Auth share one reply table (request_id -> Callable), found by the client's id.
		client_id : int = client.native.get_instance_id()
		mut on_response := fn(request_id: int, status_code: int, body: String) { _on_http_response(client_id, request_id, status_code, body) }
		mut on_error := fn(request_id: int, code: int, message: String) { _on_http_error(client_id, request_id, code, message) }
		client.native._http_response.connect(on_response)
		client.native._http_error.connect(on_error)
		client.http = HTTP{ .native = client.native }
		client.auth = Auth{ .native = client.native }

		if endpoint != "" {
			client.native.set_endpoint(endpoint)
		}
		return client
	}

	fn is_valid(self) bool {
		return self.native != null
	}

	## Set the server endpoint (e.g., "ws://localhost:2567")
	fn set_endpoint(self, endpoint: String) void {
		self.native.set_endpoint(endpoint)
	}

	## Get the server endpoint
	fn get_endpoint(self) String {
		return self.native.get_endpoint()
	}

	## Join or create a room. Check `room.is_valid()`.
	fn join_or_create(self, room_name: String, options: Dictionary = {}) Room {
		return Room.new(self.native.join_or_create(room_name, JSON.stringify(options)) as _ColyseusRoom)
	}

	## Create a new room
	fn create(self, room_name: String, options: Dictionary = {}) Room {
		return Room.new(self.native.create(room_name, JSON.stringify(options)) as _ColyseusRoom)
	}

	## Join an existing room by name
	fn join(self, room_name: String, options: Dictionary = {}) Room {
		return Room.new(self.native.join(room_name, JSON.stringify(options)) as _ColyseusRoom)
	}

	## Join a room by its ID
	fn join_by_id(self, room_id: String, options: Dictionary = {}) Room {
		return Room.new(self.native.join_by_id(room_id, JSON.stringify(options)) as _ColyseusRoom)
	}

	## Re-take a seat using the token from [method Room.get_reconnection_token]
	fn reconnect(self, reconnection_token: String) Room {
		return Room.new(self.native.reconnect(reconnection_token) as _ColyseusRoom)
	}

	## Join with a seat the server reserved for this player (`matchMaker.joinOrCreate()`, `reserveSeatFor()`):
	## the reservation it sent, as it came.
	fn consume_seat_reservation(self, reservation: Dictionary) Room {
		return Room.new(self.native.consume_seat_reservation(JSON.stringify(reservation)) as _ColyseusRoom)
	}

	## The round trip to the server (or to `endpoint`, a "ws://" or "wss://" address), the average of
	## `ping_count` pings: `callback(err: Dictionary, data: Dictionary)` with `data` `{ "endpoint": String,
	## "latency_ms": float }`. It fails after `timeout_ms`.
	fn get_latency(self, callback: Callable, endpoint: String = "", ping_count: int = 1, timeout_ms: int = 1500) int {
		return _replies_track(self.native, self.native.get_latency(endpoint, ping_count, timeout_ms), callback)
	}

	## Of `endpoints` ("ws://" or "wss://" addresses), the one of the shortest round trip, all measured at once:
	## `callback(err: Dictionary, data: Dictionary)` as `get_latency()`'s. It fails when none answers.
	fn select_by_latency(self, endpoints: []String, callback: Callable, ping_count: int = 1, timeout_ms: int = 1500) int {
		return _replies_track(self.native, self.native.select_by_latency("\n".join(endpoints), ping_count, timeout_ms), callback)
	}
}
